{
  "name": "dsh-grill-first",
  "version": "1.0.0",
  "description": "DSH 插件：开工前刨根问底——把模糊需求问成明确需求，用户确认后才放行主任务",
  "icon": "./icon.png",
  "author": "InoriMutsumi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InoriMutsumi/dsh-grill-first.git"
  },
  "homepage": "https://github.com/InoriMutsumi/dsh-grill-first#readme",
  "bugs": {
    "url": "https://github.com/InoriMutsumi/dsh-grill-first/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client/index.js",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "需求澄清",
    "需求确认",
    "grill",
    "clarification"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-settings"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.12"
  }
}
